# Staging environment — safe to show as example (no real secrets)
APP_NAME=my-app
APP_ENV=staging
APP_PORT=3000
APP_SECRET_KEY=staging-secret-key-change-me
APP_DEBUG=false

DATABASE_URL=postgres://app_user:staging_pass@staging-db.internal:5432/mydb_staging

REDIS_URL=redis://staging-redis.internal:6379/0

OPENAI_KEY=sk-placeholder-replace-in-real-env
STRIPE_SECRET_KEY=sk_test_placeholder
SENDGRID_API_KEY=SG.placeholder

JWT_SECRET=staging-jwt-secret-change-me
JWT_EXPIRY=3600

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
ADMIN_EMAIL=ops@example.com

FEATURE_NEW_DASHBOARD_ENABLED=true
FEATURE_BETA_API_ENABLED=false

LOG_LEVEL=debug
SENTRY_DSN=https://abc123@sentry.io/456
DATADOG_API_KEY=placeholder
