# Production environment — safe to show as example (no real secrets)
APP_NAME=my-app
APP_ENV=production
APP_PORT=3000
APP_SECRET_KEY=prod-secret-key-change-me
APP_DEBUG=false

DATABASE_URL=postgres://app_user:prod_pass@prod-db.internal:5432/mydb_prod

REDIS_URL=redis://prod-redis.internal:6379/0

OPENAI_KEY=sk-placeholder-replace-in-real-env
STRIPE_SECRET_KEY=sk_live_placeholder
SENDGRID_API_KEY=SG.placeholder

JWT_SECRET=prod-jwt-secret-change-me
JWT_EXPIRY=900

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
ADMIN_EMAIL=ops@example.com

FEATURE_NEW_DASHBOARD_ENABLED=true
FEATURE_BETA_API_ENABLED=false

LOG_LEVEL=warn
SENTRY_DSN=https://xyz789@sentry.io/789
DATADOG_API_KEY=placeholder
